BootStrap: debootstrap
OSVersion: jammy
MirrorURL: http://us.archive.ubuntu.com/ubuntu/

%post
    echo 'deb http://us.archive.ubuntu.com/ubuntu/ jammy main restricted universe multiverse' > /etc/apt/sources.list
    apt update
    apt-get -y install pkg-config \
                  wget \
                  git \
                  gcc \
                  build-essential \
                  cmake \
                  file \
                  libboost-iostreams-dev \
                  libboost-filesystem-dev \
                  libboost-system-dev \
                  libboost-program-options-dev
                  
%runscript
    git clone https://code.ill.fr/lst/lst-data-process-128.git
    cd lst-data-process-128/packaging
    ./buildpackage.sh /output

%labels 
    Author Yannick
                  